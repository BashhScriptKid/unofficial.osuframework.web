{
  "metadata":
  [
    {
      "src":
      [
        {
          "src": "osu-framework",
          "files":
          [
            "**/*.csproj"
          ],
          "exclude":
          [
            "SampleGame/**",
            "SampleGame.Android/**",
            "SampleGame.Desktop/**",
            "SampleGame.iOS/**",
            "osu.Framework.Templates/**"
          ]
        }
      ],
      "dest": "api",
      "outputFormat": "markdown"
    }
  ],
  "build": {
    "content":
    [
      {
        "files":
        [
          "**/*.{md,yml}"
        ],
        "exclude":
        [
          "_site/**",
	        "README.md",
          "osu-framework/README.md"
        ]
      }
    ],
    "resource":
    [
      {
        "files":
        [
          "images/**",
          "assets/**",
          "osu-framework.wiki/img/**"
        ]
      }
    ],
    "output": "_site",
    "template":
    [
      "default",
      "modern"
    ],
    "globalMetadata":
    {
      "_appName": "",
      "_appTitle": "osu!framework",
      "_appFooter": "osu!framework is licensed under the MIT licence, docs powered by docfx",
      "_appLogoPath": "assets/docfx_icon.png",
      "_appFaviconPath": "assets/nupkg icon.png",
      "_enableNewTab": true,
      "_enableSearch": true,
      "pdf": true
    },
    "sitemap": {
      "baseUrl": "https://ofw.its.moe/",
      "priority": 0.9,
      "fileOptions": {
        "**/README.md": {
          "baseUrl" : "https://ofw.its.moe/index.html"
        }
      }
    }
  }
}
